[Unit]
Description=Encrypted daily DawnPanel recovery snapshot
After=mariadb.service
StartLimitIntervalSec=6h
StartLimitBurst=3
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/dawnpanel-vault snapshot
Restart=on-failure
RestartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/dawnpanel
ReadWritePaths=/run/lock
