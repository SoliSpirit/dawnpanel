[Unit]
Description=Deliver committed DawnPanel purchase notifications
After=mariadb.service network-online.target

[Service]
Type=oneshot
User=dawnpanel
Group=dawnpanel
WorkingDirectory=/opt/dawnpanel/current
EnvironmentFile=/etc/dawnpanel/web.env
ExecStart=/opt/dawnpanel/venv/bin/python manage.py deliver_order_notices
TimeoutStartSec=75
UMask=0027
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
