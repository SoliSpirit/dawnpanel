[Unit]
Description=DawnPanel scheduled supplier price checks
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=dawnpanel
Group=dawnpanel
WorkingDirectory=/opt/dawnpanel/current
EnvironmentFile=/etc/dawnpanel/web.env
ExecStart=/opt/dawnpanel/venv/bin/python manage.py sync_source_prices --due
TimeoutStartSec=35min
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dawnpanel
